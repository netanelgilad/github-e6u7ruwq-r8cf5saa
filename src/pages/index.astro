---
import TodosStore from "../todos/astro/TodosStore.astro";
import { TodoList } from "../todos/react/TodoList";
import { PendingTasksCounter } from "../todos/react/PendingTasksCounter";
import MyAstroComp from "../components/MyAstroComp.astro";

const myArray = [1,2,3];
---

{ myArray.map(() => (
	<TodosStore>
		{(storeId: string) => (
			<TodoList client:load storeId={storeId} />
			<MyAstroComp />
			<PendingTasksCounter client:load storeId={storeId} />
		)}
	</TodosStore>
))}

