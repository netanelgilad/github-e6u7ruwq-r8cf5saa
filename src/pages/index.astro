---
import Layout from "../layouts/Layout.astro";
import TodosStore from "../components/TodosStore.astro";
import { TodoList } from "../components/TodoList";
import { PendingTasksCounter } from "../components/PendingTasksCounter";
---

<Layout>
  <TodosStore>
    {
      (storeId: string) => (
        <>
          <TodoList client:load storeId={storeId} />
          <PendingTasksCounter client:load storeId={storeId} />
        </>
      )
    }
  </TodosStore>
</Layout>
