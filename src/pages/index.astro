---
import Layout from "../layouts/Layout.astro";
import TodosStore from "../components/TodosStore.astro";
import { TodoList } from "../components/TodoList";
import { PendingTasksCounter } from "../components/PendingTasksCounter";
---

<Layout>
  <TodosStore>
    {
      (store, storeId) => (
        <>
          <TodoList client:load store={store} storeId={storeId} />
          {/* <PendingTasksCounter client:load store={store} /> */}
        </>
      )
    }
  </TodosStore>
</Layout>
